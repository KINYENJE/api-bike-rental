# Copy this file to .env and fill in your values.
# Never commit .env to version control.

MONGODB_CONNECTION_STRING="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>"

# Use a long, random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET="replace-with-64-char-random-hex"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_API_ENVIRONMENT_VARIABLE="CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>"

API_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

EMAIL_USER="your-gmail@gmail.com"
# Generate a Gmail App Password (not your account password): https://myaccount.google.com/apppasswords
EMAIL_PASS="your-gmail-app-password"

# Sanity CMS — get from https://sanity.io/manage
SANITY_PROJECT_ID="your-sanity-project-id"
SANITY_DATASET="production"

# Payments — get sandbox keys from https://sandbox.intasend.com
PAYMENT_PROVIDER="intasend"
INTASEND_PUBLISHABLE_KEY="ISPubKey_test_xxxxxxxx"
INTASEND_SECRET_KEY="ISSecretKey_test_xxxxxxxx"
# "true" uses the sandbox. Set to "false" only with live production keys.
INTASEND_TEST_MODE="true"
# Shared secret to validate incoming webhooks. Set the SAME value as the
# "challenge" you configure on your IntaSend webhook. Leave blank to skip the check.
INTASEND_WEBHOOK_CHALLENGE=""

# Comma-separated emails granted admin dashboard access.
ADMIN_EMAILS="you@example.com"

# TESTING ONLY: charge a flat amount (KES) for every booking, ignoring the real
# price (e.g. 1). Leave unset/commented to charge real booking prices.
# PAYMENT_TEST_AMOUNT=1
